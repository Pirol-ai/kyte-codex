{
  "mcpServers": {
    "kyte": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"${KYTE_PROGRAM:-kyte}\" mcp --db \"${KYTE_CODEX_DB:-$HOME/.kyte/codex}\""
      ],
      "env_vars": [
        "HOME",
        "PATH",
        "KYTE_PROGRAM",
        "KYTE_CODEX_DB",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "SSL_CERT_FILE",
        "NODE_EXTRA_CA_CERTS"
      ],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 120
    }
  }
}
